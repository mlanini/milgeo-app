{
  "name": "milgeo",
  "private": true,
  "version": "0.8.0",
  "description": "MilGeo.app — geospatial web app with APP-6D military tactical tools",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@google/genai",
    "core-js",
    "protobufjs"
  ],
  "scripts": {
    "dev": "npm run dev -w milgeo-app",
    "build": "npm run build:render -w milgeo-app",
    "build:render": "npm run build:render -w milgeo-app",
    "tauri": "npm run tauri -w milgeo-app",
    "tauri:dev": "npm run tauri dev -w milgeo-app",
    "tauri:build": "node scripts/tauri-build.mjs",
    "msix:build": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/build-msix.ps1"
  },
  "engines": {
    "node": ">=22"
  }
}
