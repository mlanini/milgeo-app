{
  "name": "@geolibre/milsymbol-server",
  "version": "0.1.0",
  "description": "Standalone HTTP server that renders APP-6D military symbols via milsymbol",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "milsymbol-server": "dist/index.js"
  },
  "scripts": {
    "dev": "node --import tsx/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "milsymbol": "^3.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
